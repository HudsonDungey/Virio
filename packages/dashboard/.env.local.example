# ─── Sepolia + Alchemy + WalletConnect ─────────────────────────────────────
# Copy to .env.local and fill in. .env.local is gitignored.

# Public Alchemy API key (Sepolia). Used by both the browser (NEXT_PUBLIC_) and the server.
# Get one at https://dashboard.alchemy.com/  →  create an app on "Ethereum Sepolia".
NEXT_PUBLIC_ALCHEMY_KEY=

# Optional direct RPC URL override. Use this instead of NEXT_PUBLIC_ALCHEMY_KEY if you prefer.
VIRIO_RPC_URL=

# Optional chain selector. Defaults to sepolia; set to anvil for local development.
VIRIO_NETWORK=sepolia

# WalletConnect Cloud project id — required for RainbowKit's WalletConnect transport.
# Get one at https://cloud.reown.com/  (formerly cloud.walletconnect.com).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only: private key for the off-chain scheduler (calls manager.charge on Sepolia).
# Use a DEDICATED Sepolia EOA. Fund with a small amount of Sepolia ETH for gas.
# Format: 0x-prefixed 64-char hex.
EXECUTOR_PRIVATE_KEY=

# ─── Programmable billing (authorization registry + modules) ────────────────
# These are SEPARATE from the deployed subscription manager, which keeps
# working unchanged. Leave them unset and the billing pages simply show
# nothing — the rest of the app is unaffected.
#
# Deploy with:  yarn deploy:billing:base-sepolia
# The script prints all four values.
NEXT_PUBLIC_VIRIO_AUTHORIZATION_REGISTRY=
NEXT_PUBLIC_VIRIO_RECURRING_BILLING=
NEXT_PUBLIC_VIRIO_METERED_BILLING=
NEXT_PUBLIC_VIRIO_BILLING_DEPLOYMENT_BLOCK=0

# ─── Feature flags ──────────────────────────────────────────────────────────
# Recurring and metered are on by default: both are covered by the contract
# test suite and target Base Sepolia first. Hybrid is not a separate contract —
# it is a HYBRID authorization settled by the same two modules — so this flag
# gates the UI only.
NEXT_PUBLIC_RECURRING_BILLING_ENABLED=true
NEXT_PUBLIC_METERED_BILLING_ENABLED=true
NEXT_PUBLIC_HYBRID_BILLING_ENABLED=true

# OFF by default and deliberately so. Neither has had the security review that
# turning it on would require. Agent delegation has no implementation at all —
# only an interface (contracts/src/billing/interfaces/IVirioAgentPolicy.sol).
NEXT_PUBLIC_AGENT_DELEGATION_ENABLED=false
NEXT_PUBLIC_X402_ADAPTER_ENABLED=false
