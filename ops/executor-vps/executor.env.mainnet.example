# Mainnet template. Use only after security review and mainnet deployment.
VIRIO_RPC_URL=https://REPLACE_WITH_YOUR_MAINNET_RPC
VIRIO_MANAGER_ADDRESS=0xREPLACE_WITH_MAINNET_SUBSCRIPTION_MANAGER
VIRIO_DEPLOYMENT_BLOCK=0
EXECUTOR_PRIVATE_KEY=0xREPLACE_WITH_A_DEDICATED_LOW-BALANCE_EXECUTOR_KEY
EXECUTOR_POLL_MS=30000
EXECUTOR_CONFIRMATIONS=5
EXECUTOR_MAX_LOG_RANGE=500
EXECUTOR_MAX_CHARGES_PER_TICK=25
EXECUTOR_MAX_SUBSCRIPTIONS_PER_TICK=250
EXECUTOR_STATE_PATH=/var/lib/virio-executor/state.json
EXECUTOR_HEALTH_PORT=9464
