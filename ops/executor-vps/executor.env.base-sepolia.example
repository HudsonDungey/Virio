# Base Sepolia executor for the programmable billing stack.
#
# This is a DIFFERENT executor from the subscription-manager one in
# executor.env.testnet.example. That contract is still deployed on Ethereum
# Sepolia and still needs its own executor; the two run side by side.
VIRIO_RPC_URL=https://sepolia.base.org
VIRIO_CHAIN_ID=84532

# From `yarn deploy:billing:base-sepolia`.
VIRIO_AUTHORIZATION_REGISTRY=0xREPLACE_WITH_DEPLOYED_REGISTRY
VIRIO_RECURRING_BILLING=0xREPLACE_WITH_DEPLOYED_RECURRING_MODULE
VIRIO_METERED_BILLING=0xREPLACE_WITH_DEPLOYED_METERED_MODULE
VIRIO_BILLING_DEPLOYMENT_BLOCK=0

# A DEDICATED funded testnet key. The executor only ever calls charge() and
# settle(); it can move no funds of its own beyond gas, and it earns the
# executor fee on every settlement it lands.
EXECUTOR_PRIVATE_KEY=0xREPLACE_WITH_A_DEDICATED_FUNDED_TESTNET_KEY

EXECUTOR_POLL_MS=30000
EXECUTOR_CONFIRMATIONS=2
EXECUTOR_MAX_LOG_RANGE=2000
EXECUTOR_MAX_CHARGES_PER_TICK=25
EXECUTOR_STATE_PATH=/var/lib/virio-executor/billing-state.json
EXECUTOR_HEALTH_PORT=9465

# Optional. A merchant-run endpoint returning signed usage statements as
# [{ statement, signature }, …]. Metered settlement needs a statement only the
# merchant can sign, so without this the executor runs recurring billing only.
# Treat whatever it returns as untrusted input — the executor does.
VIRIO_STATEMENTS_URL=
